{
  "name": "@wmjoon/editorial-design-system",
  "version": "0.1.2",
  "description": "Shared editorial tokens and Markdown renderer for WMJOON properties.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "files": ["dist", "editorial.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./editorial.css": "./editorial.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
